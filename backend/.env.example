# ==============================================================================
# ชื่อไฟล์: backend/.env.example
# หน้าที่: แม่แบบกำหนดค่าตัวแปรสภาพแวดล้อม (Environment Variables Template)
# วิธีใช้: คัดลอกไฟล์นี้เป็น backend/.env แล้วตั้งค่าให้ตรงกับเครื่องของคุณ
# ==============================================================================

# พอร์ตสำหรับรัน Backend Server (ค่าเริ่มต้นคือ 5000)
PORT=5000

# รหัสลับสำหรับเข้ารหัสและถอดรหัส JWT Token (ใช้สำหรับระบบ Login และตรวจสอบสิทธิ์)
# แนะนำให้เปลี่ยนเป็นสตริงสุ่มที่มีความปลอดภัยสูง
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key

# URL ของ AI GPU Server (Stable Diffusion WebUI / Forge)
# ตัวอย่าง: http://127.0.0.1:8088 หรือ IP เครื่อง AI ในวงแลน เช่น http://172.20.56.158:8088
AI_SERVER_URL=http://127.0.0.1:8088
