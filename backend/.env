PORT=5000
JWT_SECRET_KEY=my_super_secret_key_12345
AI_SERVER_URL=http://127.0.0.1:8088
# ---- ค่าที่เพิ่มมาสำหรับรันหลัง nginx ----
# HOST=127.0.0.1  (default) → รับเฉพาะ nginx บนเครื่องเดียวกัน | 0.0.0.0 = เปิดให้ทั้ง LAN (ชั่วคราวตอน debug เท่านั้น)
HOST=127.0.0.1
# FLASK_DEBUG=1 เปิด debugger — ห้ามเปิดตอนคนอื่นเข้าถึงเครื่องได้
FLASK_DEBUG=0
# origin ที่ให้เรียก API ข้าม origin ได้ (ผ่าน nginx ไม่ต้องใช้)
CORS_ORIGINS=http://localhost:5173
