# ==============================================================================
# ชื่อไฟล์: backend/.env
# หน้าที่: กำหนดค่าตัวแปรสภาพแวดล้อม (Environment Variables) สำหรับ Backend Flask
# ==============================================================================

# พอร์ตสำหรับรัน Backend Server (ค่าเริ่มต้นคือ 5000)
PORT=5000

# รหัสลับสำหรับเข้ารหัสและถอดรหัส JWT Token (ใช้สำหรับระบบ Login และตรวจสอบสิทธิ์)
JWT_SECRET_KEY=my_super_secret_key_12345

# URL ของ AI GPU Server (Stable Diffusion WebUI / Forge)
# ให้ใส่ IP และ Port ของเครื่องที่รัน AI เช่น http://172.20.56.158:8088
AI_SERVER_URL=http://172.20.56.158:8088