# Dev (working alone):        http://localhost:5000/api/v1
# Integrate (LAN, direct):    http://192.168.1.20:5000/api/v1
# Integrate (behind nginx):   /api/v1  (relative — browser never talks to :5000
#                              directly; nginx's own /api/v1/ location proxies
#                              it to the Flask backend instead)
VITE_API_BASE_URL=/api/v1

# Dev Preview Mode: set to true to browse every page with mock data,
# no Backend required. Set to false (or remove) once integrating for real.
VITE_MOCK_MODE=false

